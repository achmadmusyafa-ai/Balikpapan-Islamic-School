rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile and private learning progress
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.level is number
        && request.resource.data.currentXp is number;

      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.level is number
        && request.resource.data.currentXp is number;

      allow delete: if false;
    }

    // Public student leaderboard
    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.totalXp is number
        && request.resource.data.level is number;

      allow delete: if isOwner(userId);
    }

    // Custom chapters and questions created by teachers
    match /custom_chapters/{chapterId} {
      allow get, list: if true;
      allow create, update: if isSignedIn()
        && isValidId(chapterId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string;
      allow delete: if isSignedIn();
    }

    // School accounts for students and teachers (SDIT Balikpapan Islamic School)
    match /school_accounts/{accountId} {
      allow get, list: if true;
      allow create, update: if isValidId(accountId)
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 50;
      allow delete: if false;
    }
  }
}
